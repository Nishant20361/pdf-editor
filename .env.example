# Copy this file to .env for local Mac use.
LOCAL_MODE=true
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Replace YOUR_MAC_USERNAME with your macOS username.
DATABASE_URL="sqlite:////Users/YOUR_MAC_USERNAME/Documents/PDFEditorData/pdf_editor.db"
STORAGE_BACKEND=local
UPLOAD_DIR="/Users/YOUR_MAC_USERNAME/Documents/PDFEditorData/files"

ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# 0 disables automatic deletion for local use.
FILE_TTL_MINUTES=0
CLEANUP_INTERVAL_SECONDS=300

MAX_FILE_SIZE_MB=50
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=25000000
MAX_DOCUMENTS_PER_USER=1000
MAX_EXPORTS_PER_HOUR=1000
MAX_OCR_PER_HOUR=1000
MAX_STORAGE_PER_USER_MB=10240
RATE_LIMIT_PER_MINUTE=600
PREVIEW_DPI=150

# Authentication and cloud storage remain available for a future deployment.
JWT_SECRET_KEY=replace-with-a-secure-random-key-before-deployment
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
